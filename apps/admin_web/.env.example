# Base URL of the FastAPI backend (no /api/v1 suffix)
VITE_API_BASE_URL=http://localhost:8000
# Supabase project (public values only). NEVER put the service-role key here: anything with the VITE_ prefix ships to the browser.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon/publishable key>
# Production build: run `npm run build` with the production values only (no localhost / test values); host with an SPA fallback to index.html.
# Public values only (they are bundled into the browser). Use a different file per environment (.env.development / .env.production, both git-ignored);
# the backend's CORS_ORIGINS must list this site's origin. The admin console never holds a Firebase, payment or service-role credential.
