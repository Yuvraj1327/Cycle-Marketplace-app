# Base URL of the FastAPI backend (no /api/v1 suffix)
VITE_API_BASE_URL=http://localhost:8000
# Supabase project (public values only). NEVER put the service-role key here: anything with the VITE_ prefix ships to the browser.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon/publishable key>
