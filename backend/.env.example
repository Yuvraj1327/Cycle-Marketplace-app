# Application
APP_NAME=Cycle Marketplace API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# Supabase (placeholders only - never commit real values)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT verification (access tokens issued by Supabase Auth).
# New projects use asymmetric signing keys: tokens are verified against
#   <SUPABASE_URL>/auth/v1/.well-known/jwks.json  -> leave SUPABASE_JWT_SECRET empty.
# Only set the secret if your project still uses the legacy shared HS256 secret
# (Supabase dashboard > Project Settings > JWT Keys > Legacy JWT secret).
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated
JWT_LEEWAY_SECONDS=5
JWKS_CACHE_SECONDS=600

# Server-side only. NEVER copy the service-role key into the Flutter or React apps.

# Marketplace limits (optional; defaults shown)
# MAX_PRODUCT_IMAGES=8
# MAX_IMAGE_BYTES=5242880
# MAX_CART_ITEMS=50
# MAX_WISHLIST_ITEMS=200

# Payments. NO provider is chosen yet: leave PAYMENT_PROVIDER empty and online payments report "not configured" (COD still works when an admin enables it).
# See docs/orders-payments.md for what the client must provide. Secrets stay on the server - never in the Flutter or React apps.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_KEY_ID=
PAYMENT_PROVIDER_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
CURRENCY=INR

# Servicing: 'today' and slot times are evaluated in this timezone (IANA name)
BUSINESS_TIMEZONE=Asia/Kolkata
